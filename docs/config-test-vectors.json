{
  "about": "Config validation cases shared by the host (C#) and firmware (C++) tests. Each case applies 'patch' to docs/default-config.json ('set' adds or replaces, '-' appends to an array; 'remove' deletes) and expects the validator to accept it ('where' null) or to reject it with an error that starts with 'where'. 'device' overrides the expectation for the firmware, which ignores host-only sections (weather, stats, media.app_priority, media.art_size).",
  "cases": [
    { "name": "default config", "patch": [], "where": null },
    { "name": "unknown keys are ignored", "patch": [{ "op": "set", "path": "/future", "value": 1 }], "where": null },
    { "name": "optional sections may be missing", "patch": [{ "op": "remove", "path": "/display" }, { "op": "remove", "path": "/theme" }, { "op": "remove", "path": "/units" }, { "op": "remove", "path": "/sensor" }, { "op": "remove", "path": "/media" }, { "op": "remove", "path": "/grid" }], "where": null },
    { "name": "empty page", "patch": [{ "op": "set", "path": "/pages/-", "value": { "id": "empty", "name": "Empty", "widgets": [] } }], "where": null },
    { "name": "label widget", "patch": [{ "op": "set", "path": "/pages/-", "value": { "id": "notes", "name": "Notes", "widgets": [{ "type": "label", "x": 0, "y": 0, "w": 4, "h": 1, "text": "Hello çşğ" }] } }], "where": null },
    { "name": "page input override", "patch": [{ "op": "set", "path": "/pages/0/inputs_override", "value": { "enc1": { "rotate_pressed": "media.volume" }, "btn1": { "long": "media.mute" } } }], "where": null },
    { "name": "metric style fields", "patch": [{ "op": "set", "path": "/pages/1/widgets/5/min", "value": 10 }, { "op": "set", "path": "/pages/1/widgets/5/max", "value": 90 }, { "op": "set", "path": "/pages/1/widgets/5/unit", "value": "" }, { "op": "set", "path": "/pages/1/widgets/5/decimals", "value": 0 }], "where": null },

    {"name": "sixteen data sources (7 in the default layout + 9)", "patch": [{"op": "set", "path": "/pages/-", "value": {"id": "fans1", "name": "fans1", "widgets": [{"type": "metric_value", "x": 0, "y": 0, "w": 1, "h": 1, "source": "sys.fan.1.rpm"}, {"type": "metric_value", "x": 1, "y": 0, "w": 1, "h": 1, "source": "sys.fan.2.rpm"}, {"type": "metric_value", "x": 2, "y": 0, "w": 1, "h": 1, "source": "sys.fan.3.rpm"}, {"type": "metric_value", "x": 3, "y": 0, "w": 1, "h": 1, "source": "sys.fan.4.rpm"}, {"type": "metric_value", "x": 0, "y": 1, "w": 1, "h": 1, "source": "sys.fan.5.rpm"}, {"type": "metric_value", "x": 1, "y": 1, "w": 1, "h": 1, "source": "sys.fan.6.rpm"}, {"type": "metric_value", "x": 2, "y": 1, "w": 1, "h": 1, "source": "sys.fan.7.rpm"}, {"type": "metric_value", "x": 3, "y": 1, "w": 1, "h": 1, "source": "sys.fan.8.rpm"}, {"type": "metric_value", "x": 0, "y": 2, "w": 1, "h": 1, "source": "sys.fan.9.rpm"}]}}], "where": null},
    {"name": "too many data sources", "patch": [{"op": "set", "path": "/pages/-", "value": {"id": "fans1", "name": "fans1", "widgets": [{"type": "metric_value", "x": 0, "y": 0, "w": 1, "h": 1, "source": "sys.fan.1.rpm"}, {"type": "metric_value", "x": 1, "y": 0, "w": 1, "h": 1, "source": "sys.fan.2.rpm"}, {"type": "metric_value", "x": 2, "y": 0, "w": 1, "h": 1, "source": "sys.fan.3.rpm"}, {"type": "metric_value", "x": 3, "y": 0, "w": 1, "h": 1, "source": "sys.fan.4.rpm"}, {"type": "metric_value", "x": 0, "y": 1, "w": 1, "h": 1, "source": "sys.fan.5.rpm"}, {"type": "metric_value", "x": 1, "y": 1, "w": 1, "h": 1, "source": "sys.fan.6.rpm"}, {"type": "metric_value", "x": 2, "y": 1, "w": 1, "h": 1, "source": "sys.fan.7.rpm"}, {"type": "metric_value", "x": 3, "y": 1, "w": 1, "h": 1, "source": "sys.fan.8.rpm"}, {"type": "metric_value", "x": 0, "y": 2, "w": 1, "h": 1, "source": "sys.fan.9.rpm"}, {"type": "metric_value", "x": 1, "y": 2, "w": 1, "h": 1, "source": "sys.fan.10.rpm"}]}}, {"op": "set", "path": "/pages/-", "value": {"id": "fans2", "name": "fans2", "widgets": [{"type": "metric_value", "x": 0, "y": 0, "w": 1, "h": 1, "source": "sys.fan.11.rpm"}, {"type": "metric_value", "x": 1, "y": 0, "w": 1, "h": 1, "source": "sys.fan.12.rpm"}, {"type": "metric_value", "x": 2, "y": 0, "w": 1, "h": 1, "source": "sys.fan.13.rpm"}, {"type": "metric_value", "x": 3, "y": 0, "w": 1, "h": 1, "source": "sys.fan.14.rpm"}, {"type": "metric_value", "x": 0, "y": 1, "w": 1, "h": 1, "source": "sys.fan.15.rpm"}, {"type": "metric_value", "x": 1, "y": 1, "w": 1, "h": 1, "source": "sys.fan.16.rpm"}, {"type": "metric_value", "x": 2, "y": 1, "w": 1, "h": 1, "source": "sys.fan.17.rpm"}, {"type": "metric_value", "x": 3, "y": 1, "w": 1, "h": 1, "source": "sys.fan.18.rpm"}, {"type": "metric_value", "x": 0, "y": 2, "w": 1, "h": 1, "source": "sys.fan.19.rpm"}, {"type": "metric_value", "x": 1, "y": 2, "w": 1, "h": 1, "source": "sys.fan.20.rpm"}]}}], "where": "pages"},
    { "name": "wrong schema", "patch": [{ "op": "set", "path": "/schema", "value": 2 }], "where": "schema" },
    { "name": "schema missing", "patch": [{ "op": "remove", "path": "/schema" }], "where": "schema" },
    { "name": "pages missing", "patch": [{ "op": "remove", "path": "/pages" }], "where": "pages" },
    { "name": "no pages", "patch": [{ "op": "set", "path": "/pages", "value": [] }], "where": "pages" },
    { "name": "brightness above 100", "patch": [{ "op": "set", "path": "/display/brightness", "value": 101 }], "where": "display.brightness" },
    { "name": "brightness as a string", "patch": [{ "op": "set", "path": "/display/brightness", "value": "80" }], "where": "display.brightness" },
    { "name": "night time out of range", "patch": [{ "op": "set", "path": "/display/night/from", "value": "25:00" }], "where": "display.night.from" },
    { "name": "spi clock too high", "patch": [{ "op": "set", "path": "/display/spi_hz", "value": 100000000 }], "where": "display.spi_hz" },
    { "name": "grid too wide", "patch": [{ "op": "set", "path": "/grid/cols", "value": 9 }], "where": "grid.cols" },
    { "name": "smaller grid leaves a widget outside", "patch": [{ "op": "set", "path": "/grid/cols", "value": 3 }], "where": "pages[0].widgets[1]" },
    { "name": "bad accent color", "patch": [{ "op": "set", "path": "/theme/accent", "value": "blue" }], "where": "theme.accent" },
    { "name": "unknown wind unit", "patch": [{ "op": "set", "path": "/units/wind", "value": "knots" }], "where": "units.wind" },
    { "name": "temperature offset too large", "patch": [{ "op": "set", "path": "/sensor/temp_offset_c", "value": 20 }], "where": "sensor.temp_offset_c" },
    { "name": "volume step zero", "patch": [{ "op": "set", "path": "/media/volume_step", "value": 0 }], "where": "media.volume_step" },
    { "name": "too many buttons", "patch": [{ "op": "set", "path": "/inputs/buttons", "value": 3 }], "where": "inputs.buttons" },
    { "name": "counts per detent zero", "patch": [{ "op": "set", "path": "/inputs/enc1/counts_per_detent", "value": 0 }], "where": "inputs.enc1.counts_per_detent" },
    { "name": "unknown action", "patch": [{ "op": "set", "path": "/inputs/enc1/click", "value": "media.foo" }], "where": "inputs.enc1.click" },
    { "name": "press action on a rotate gesture", "patch": [{ "op": "set", "path": "/inputs/enc1/rotate", "value": "media.next" }], "where": "inputs.enc1.rotate" },
    { "name": "rotate action on a click", "patch": [{ "op": "set", "path": "/inputs/enc2/click", "value": "media.volume" }], "where": "inputs.enc2.click" },
    { "name": "rotate action on a button", "patch": [{ "op": "set", "path": "/inputs/btn2/long", "value": "nav.page" }], "where": "inputs.btn2.long" },
    { "name": "bad action in a page override", "patch": [{ "op": "set", "path": "/pages/0/inputs_override", "value": { "enc1": { "click": "nope" } } }], "where": "pages[0].inputs_override.enc1.click" },
    { "name": "duplicate page id", "patch": [{ "op": "set", "path": "/pages/1/id", "value": "now_playing" }], "where": "pages[1].id" },
    { "name": "empty page id", "patch": [{ "op": "set", "path": "/pages/1/id", "value": "" }], "where": "pages[1].id" },
    { "name": "page name too long", "patch": [{ "op": "set", "path": "/pages/1/name", "value": "A page name that is far too long for the bar" }], "where": "pages[1].name" },
    { "name": "unknown widget type", "patch": [{ "op": "set", "path": "/pages/0/widgets/0/type", "value": "foo" }], "where": "pages[0].widgets[0]" },
    { "name": "overlapping widgets", "patch": [{ "op": "set", "path": "/pages/0/widgets/1/x", "value": 1 }], "where": "pages[0].widgets[1]" },
    { "name": "widget outside the grid", "patch": [{ "op": "set", "path": "/pages/0/widgets/3/x", "value": 4 }], "where": "pages[0].widgets[3]" },
    { "name": "negative position", "patch": [{ "op": "set", "path": "/pages/0/widgets/0/x", "value": -1 }], "where": "pages[0].widgets[0]" },
    { "name": "size not allowed", "patch": [{ "op": "set", "path": "/pages/1/widgets/0/w", "value": 2 }], "where": "pages[1].widgets[0]" },
    { "name": "metric without source", "patch": [{ "op": "remove", "path": "/pages/1/widgets/0/source" }], "where": "pages[1].widgets[0].source" },
    { "name": "label too long", "patch": [{ "op": "set", "path": "/pages/1/widgets/0/label", "value": "This label is much too long to fit" }], "where": "pages[1].widgets[0].label" },
    { "name": "min not below max", "patch": [{ "op": "set", "path": "/pages/1/widgets/5/min", "value": 100 }], "where": "pages[1].widgets[5]" },
    { "name": "too many decimals", "patch": [{ "op": "set", "path": "/pages/1/widgets/6/decimals", "value": 4 }], "where": "pages[1].widgets[6].decimals" },
    { "name": "unknown forecast mode", "patch": [{ "op": "set", "path": "/pages/2/widgets/2/mode", "value": "weekly" }], "where": "pages[2].widgets[2].mode" },
    { "name": "label widget without text", "patch": [{ "op": "set", "path": "/pages/-", "value": { "id": "notes", "name": "Notes", "widgets": [{ "type": "label", "x": 0, "y": 0, "w": 1, "h": 1 }] } }], "where": "pages[3].widgets[0].text" },

    { "name": "weather refresh too fast (host only)", "patch": [{ "op": "set", "path": "/weather/refresh_min", "value": 1 }], "where": "weather.refresh_min", "device": null },
    { "name": "latitude out of range (host only)", "patch": [{ "op": "set", "path": "/weather/lat", "value": 91 }, { "op": "set", "path": "/weather/lon", "value": 29 }], "where": "weather.lat", "device": null },
    { "name": "stats rate too high (host only)", "patch": [{ "op": "set", "path": "/stats/rate_hz", "value": 10 }], "where": "stats.rate_hz", "device": null }
  ]
}
