<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>rez-pad</AssemblyName>
    <RootNamespace>RezPad.Host</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- D3DKMT statistics buffers (Stats/GpuEngines.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel for the localhost config editor and API. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RezPad.Protocol\RezPad.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Built-in default config, the same file the firmware's default is generated from. -->
    <EmbeddedResource Include="..\..\..\docs\default-config.json" LogicalName="RezPad.Host.default-config.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The web editor lives in the repo's web/ folder and is copied next to the exe. -->
    <Content Include="..\..\..\web\**\*" LinkBase="web" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Latest stable on nuget.org, verified 2026-11-07 (0.9.7 still prerelease). MPL-2.0. Uses the
         PawnIO driver (installed separately) for CPU temperature and motherboard sensors. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
