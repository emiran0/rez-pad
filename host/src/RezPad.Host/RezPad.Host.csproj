<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>rez-pad</AssemblyName>
    <!-- FileDescription: the name Task Manager lists the process under. -->
    <AssemblyTitle>rez-pad</AssemblyTitle>
    <RootNamespace>RezPad.Host</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- D3DKMT statistics buffers (Stats/GpuEngines.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon Condition="Exists('rez-pad.ico')">rez-pad.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <!-- tools/package.ps1: one self-contained exe, no .NET install needed on the target PC. Native
         libraries go inside it too; not trimmed (WinForms and LibreHardwareMonitor use reflection). -->
    <RuntimeIdentifier Condition="'$(PublishSingleFile)' == 'true'">win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel for the localhost config editor and API. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\RezPad.Protocol\RezPad.Protocol.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Tray icons from tools/gen_app_icon.py (connected / not connected). -->
    <EmbeddedResource Include="tray-on.ico;tray-off.ico" LogicalName="RezPad.Host.%(Filename)%(Extension)" />
    <!-- Built-in default config, the same file the firmware's default is generated from. -->
    <EmbeddedResource Include="..\..\..\docs\default-config.json" LogicalName="RezPad.Host.default-config.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- The web editor lives in the repo's web/ folder and is embedded in the exe (single-file publish),
         as RezPad.Host.web.<path with dots> for EmbeddedFileProvider. -->
    <EmbeddedResource Include="..\..\..\web\**\*" LogicalName="RezPad.Host.web.$([System.String]::Copy('%(RecursiveDir)').Replace('\','.'))%(Filename)%(Extension)" />
    <!-- The firmware image built next to this host (tools/package.ps1 builds it first), for the
         update on the Device page. Without it the host still runs; it just cannot update the board. -->
    <EmbeddedResource Include="..\..\..\firmware\.pio\build\rezpad\firmware.factory.bin" LogicalName="RezPad.Host.firmware.bin"
                      Condition="Exists('..\..\..\firmware\.pio\build\rezpad\firmware.factory.bin')" />
  </ItemGroup>
  <ItemGroup>
    <!-- Latest stable on nuget.org, verified 2026-11-07 (0.9.7 still prerelease). MPL-2.0. Uses the
         PawnIO driver (installed separately) for CPU temperature and motherboard sensors. -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
</Project>
